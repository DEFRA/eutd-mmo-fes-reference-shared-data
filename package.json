{
  "name": "mmo-shared-reference-data",
  "version": "1.4.0-beta.6",
  "description": "Shared repo which holds common code of reference data reader and batch data repo",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "cross-env JEST_JUNIT_OUTPUT_DIR=test-results JEST_JUNIT_OUTPUT_NAME=test-results.xml NODE_ENV=test jest test/ --coverage --ci",
    "test:ci": "cross-env JEST_JUNIT_OUTPUT_DIR=test-results JEST_JUNIT_OUTPUT_NAME=junit.xml NODE_ENV=test jest --runInBand --watchAll=false --reporters=default --reporters=jest-junit --coverage --ci",
    "test:watch": "cross-env JEST_JUNIT_OUTPUT_DIR=test-results JEST_JUNIT_OUTPUT_NAME=test-results.xml NODE_ENV=test jest --runInBand test/ --coverage --ci --watch",
    "lint": "eslint . --ext .ts"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/csvtojson": "2.0.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "babel-jest": "29.7.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-jest": "29.15.4",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "9.0.11",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.3",
    "sinon": "17.0.1",
    "ts-jest": "^29.4.6",
    "tsup": "8.5.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "ajv": "^8.20.0",
    "axios": "^1.18.1",
    "bunyan": "1.8.15",
    "cross-env": "7.0.3",
    "csvtojson": "^2.0.14",
    "dotenv": "16.4.5",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "fast-xml-builder": "^1.3.0",
    "form-data": "^4.0.6",
    "uuid": "^14.0.0",
    "@babel/core": "^7.29.7",
    "esbuild": "0.28.1",
    "js-yaml": "^3.15.0",
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.0"
    },
    "eslint": {
      "js-yaml": "^4.3.0"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest",
      "^.+\\.ts?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "tsx",
      "ts",
      "js",
      "json"
    ],
    "testRegex": "/test/.*\\.(tsx|ts|js)$",
    "testPathIgnorePatterns": [
      "/test/mockData.js"
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "clover",
      "json",
      "lcov",
      "text",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "allowScripts": {
    "dtrace-provider@0.8.8": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
